GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_UPLOAD_MB=5
# Deployment (all optional)
PORT=8000
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=600
# Set true only behind a proxy you control (e.g. Render) so X-Forwarded-For is trusted.
TRUST_PROXY=false
# Comma-separated origins to allow cross-origin calls from. Empty = CORS disabled.
CORS_ORIGINS=
# WEB_CONCURRENCY=1   # uvicorn worker processes; the rate limit is counted per worker
